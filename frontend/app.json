{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.izza_m1.frontend"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "cameraPermission": "MediSafe AI needs camera access to scan supplement labels.",
          "microphonePermission": false,
          "photosPermission": "MediSafe AI needs photo library access to select supplement images."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5b06420d-f535-47de-8d53-d7c83016f8d2"
      }
    },
    "owner": "izza_m1"
  }
}
